<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/studioFragment">

    <fragment
        android:id="@+id/studioFragment"
        android:name="com.imagetovideo.app.ui.main.StudioFragment"
        android:label="Studio"
        tools:layout="@layout/fragment_studio" />

    <fragment
        android:id="@+id/creationsFragment"
        android:name="com.imagetovideo.app.ui.main.CreationsFragment"
        android:label="Creations"
        tools:layout="@layout/fragment_creations" />

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.imagetovideo.app.ui.main.ExploreFragment"
        android:label="Explore"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.imagetovideo.app.ui.main.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_adminFragment"
            app:destination="@id/adminFragment" />
        <action
            android:id="@+id/action_profileFragment_to_creditHistoryFragment"
            app:destination="@id/creditHistoryFragment" />
        <action
            android:id="@+id/action_profileFragment_to_creditPackagesFragment"
            app:destination="@id/creditPackagesFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.imagetovideo.app.ui.main.AdminFragment"
        android:label="Admin Panel"
        tools:layout="@layout/fragment_admin" />

    <fragment
        android:id="@+id/creditHistoryFragment"
        android:name="com.imagetovideo.app.ui.main.CreditHistoryFragment"
        android:label="Credit History"
        tools:layout="@layout/fragment_credit_history" />

    <fragment
        android:id="@+id/creditPackagesFragment"
        android:name="com.imagetovideo.app.ui.main.CreditPackagesFragment"
        android:label="Buy Credits"
        tools:layout="@layout/fragment_credit_packages" />

</navigation>
